{
  "name": "magic-pickle",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "description": "Firefox extension: collection-order picklists and printing availability for Moxfield decks",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts",
    "dev": "vite build --watch & vite build -c vite.content.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir dist --self-hosted",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run lint:ext",
    "build:harness": "vite build -c vite.harness.config.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@types/webextension-polyfill": "0.12.6",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  },
  "dependencies": {
    "keyrune": "3.19.0",
    "preact": "10.29.8",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  }
}
