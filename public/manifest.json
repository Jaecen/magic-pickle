{
  "manifest_version": 3,
  "name": "Magic Pickle",
  "version": "1.3.0",
  "description": "Collection-order picklists and printing availability for your Moxfield decks.",
  "icons": {
    "48": "icons/pickle.svg",
    "96": "icons/pickle.svg"
  },
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://api2.moxfield.com/*",
    "https://api.scryfall.com/*",
    "https://moxfield.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Magic Pickle",
    "default_icon": "icons/pickle.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moxfield.com/*",
        "https://www.moxfield.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "magic-pickle@uninitialized.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/Jaecen/magic-pickle/main/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
